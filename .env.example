# Live runtime used in a Manyfold-managed Sprite/Codex environment.
AI_RUNTIME=manyfold-codex

# Verified in the current Manyfold model configuration. Recheck after moving accounts/runtimes.
AI_ECONOMY_MODEL=gpt-5.4-mini
AI_REASONING_MODEL=gpt-5.6-terra

# Public Vercel bridge -> isolated Manyfold A2A orchestrator.
# The RPC URL is non-secret. MF_A2A_BEARER is a revocable secret and must be set only
# in Vercel encrypted environment settings, never in a VITE_* variable or this file.
MANYFOLD_A2A_RPC_URL=https://api.manyfold.ai/api/a2a/agents/agt_agp6y5mgxr5qzf33egqz6sqcc4/rpc
MF_A2A_BEARER=

# Competition-demo best-effort per-instance budget guards.
DEMO_RATE_LIMIT=12
DEMO_RATE_WINDOW_SECONDS=900
DEMO_DAILY_REQUEST_LIMIT=40
DEMO_MAX_CONCURRENT_REQUESTS=2

# Zero-credit isolated workspace synchronization (not required by Vercel).
MANYFOLD_ORCHESTRATOR_AGENT_ID=agt_agp6y5mgxr5qzf33egqz6sqcc4
MANYFOLD_ORCHESTRATOR_WORKSPACE=/home/sprite/.manyfold/workspaces/ai-hospitality-team-orchestrator

# Optional development-only non-secret endpoint override. The isolated A2A workspace instead
# uses manyfold-runtime.json, generated from the official `mf model-config get` result.
# AI_PROVIDER_BASE_URL=https://example-compatible-provider.invalid
# AI_MODEL_CONFIG_FILE=/absolute/path/to/manyfold-runtime.json

# Node production server port.
PORT=8080

# Test-only simulation. It is always disclosed as "Test fixture mode" in the UI.
# AI_RUNTIME=fixture

# Never put actual tokens, passwords, OAuth credentials, or provider keys in this file.
